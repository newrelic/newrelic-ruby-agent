# frozen_string_literal: true

instrumentation_methods :chain, :prepend

ELASTICSEARCH_VERSIONS = [
  # only testing 7 and 9 to prevent memory issues in the CI (8 and 9 are the same)
  [nil],
  ['7.17.1']
]

def gem_list(elasticsearch_version = nil)
  <<~RB
    gem 'elasticsearch'#{elasticsearch_version}

    # multi_json (pulled in by elasticsearch-transport) calls JSON.parse(source, options),
    # which json 3.0 no longer accepts (ArgumentError: wrong number of arguments).
    # TODO: remove this pin once multi_json/elasticsearch-transport support json 3.x.
    gem 'json', '< 3'
  RB
end

create_gemfiles(ELASTICSEARCH_VERSIONS)
