# frozen_string_literal: true

omit_collector!

# Testing multiple pinned psych/stringio versions in the same job used to cause
# Bundler "already activated" errors, since they're default gems and only one
# version can be active per process. Rather than fight that, just test whatever
# psych/stringio veresions ship by default
gemfile <<~RB
  gem 'stringio'
  # stub file system so we can test that newrelic.yml can be loaded from
  # various places.
  gem 'fakefs', :require => false

  gem 'psych'
  gem 'jar-dependencies', '0.4.1' if RUBY_PLATFORM == 'java'

  # don't start the agent
  gem 'newrelic_rpm', :require => false, :path => File.expand_path('../../../../')
RB
