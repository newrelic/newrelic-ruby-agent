# Rails starts the agent partway through a Rake task. This file does the same.
require 'bundler/setup'
require 'logger'

task :start_agent do
  Bundler.require
  require 'tasks/newrelic'
end

task :my_task, [:arg] => :start_agent do
  puts 'my_task'
end
